{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://esegments.com/schemas/module.json",
    "title": "Module Manifest",
    "description": "Schema for module.json files in Laravel modular architecture",
    "type": "object",
    "required": ["name", "version", "providers"],
    "properties": {
        "name": {
            "type": "string",
            "description": "The module name in PascalCase",
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "examples": ["Blog", "Products", "UserManagement"]
        },
        "alias": {
            "type": "string",
            "description": "Short alias for the module (used in routes, config)",
            "pattern": "^[a-z][a-z0-9-]*$",
            "examples": ["blog", "products", "user-management"]
        },
        "version": {
            "type": "string",
            "description": "Semantic version of the module",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
            "examples": ["1.0.0", "2.1.0-beta", "1.0.0+build.123"]
        },
        "description": {
            "type": "string",
            "description": "A brief description of the module's purpose",
            "examples": ["Blog module for managing posts and comments"]
        },
        "priority": {
            "type": "integer",
            "description": "Load priority (higher = loads later)",
            "default": 0,
            "minimum": -1000,
            "maximum": 1000
        },
        "providers": {
            "type": "array",
            "description": "Service provider classes to register",
            "items": {
                "type": "string",
                "pattern": "^[A-Z][a-zA-Z0-9\\\\]*ServiceProvider$"
            },
            "minItems": 1,
            "examples": [["Modules\\Blog\\Providers\\BlogServiceProvider"]]
        },
        "requires": {
            "type": "object",
            "description": "Module dependencies with version constraints",
            "additionalProperties": {
                "type": "string",
                "description": "Version constraint (semver)",
                "examples": ["^1.0", ">=2.0 <3.0", "~1.5"]
            },
            "examples": [{"Core": "^1.0", "Users": ">=2.0"}]
        },
        "conflicts": {
            "type": "object",
            "description": "Modules that conflict with this one",
            "additionalProperties": {
                "type": "string",
                "description": "Version constraint that conflicts"
            },
            "examples": [{"OldBlog": "*"}]
        },
        "keywords": {
            "type": "array",
            "description": "Keywords for discovery and categorization",
            "items": {
                "type": "string"
            },
            "examples": [["blog", "content", "cms"]]
        },
        "authors": {
            "type": "array",
            "description": "Module authors",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "homepage": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "required": ["name"]
            }
        },
        "license": {
            "type": "string",
            "description": "SPDX license identifier",
            "examples": ["MIT", "Apache-2.0", "proprietary"]
        },
        "homepage": {
            "type": "string",
            "description": "Module homepage URL",
            "format": "uri"
        },
        "support": {
            "type": "object",
            "description": "Support channels",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "issues": {
                    "type": "string",
                    "format": "uri"
                },
                "docs": {
                    "type": "string",
                    "format": "uri"
                }
            }
        }
    },
    "additionalProperties": true
}
